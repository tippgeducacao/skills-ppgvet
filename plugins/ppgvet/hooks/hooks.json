{
  "description": "SessionStart: põe no contexto o essencial da marca e o mapa das skills (regras/sempre.md). Stop: o portão de entrega (scripts/portao.py) devolve o turno uma vez se a última conferência de uma peça reprovou",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf 'Pacote ppgvet: %s\\n\\n' \"${CLAUDE_PLUGIN_ROOT}\"; cat \"${CLAUDE_PLUGIN_ROOT}/regras/sempre.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -s \"$HOME/.ppgvet/conferencias.jsonl\" ] || exit 0; PY=\"$(cat \"$HOME/.ppgvet/python\" 2>/dev/null)\"; [ -n \"$PY\" ] && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/scripts/portao.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
